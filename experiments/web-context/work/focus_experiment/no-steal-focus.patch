+            // Wellphone experiment: keep the primary display as the top focused display.
+            // Query runtime constants because OEM backports do not follow SDK_INT reliably.
+            // Fail closed if this device does not expose the required focus capabilities.
+            int ownFocus = android.hardware.display.DisplayManager.class
+                    .getField("VIRTUAL_DISPLAY_FLAG_OWN_FOCUS").getInt(null);
+            int noSteal = android.hardware.display.DisplayManager.class
+                    .getField("VIRTUAL_DISPLAY_FLAG_STEAL_TOP_FOCUS_DISABLED").getInt(null);
+            int ownFocusDisplay = android.view.Display.class.getField("FLAG_OWN_FOCUS").getInt(null);
+            int noStealDisplay = android.view.Display.class.getField("FLAG_STEAL_TOP_FOCUS_DISABLED").getInt(null);
+            flags |= VIRTUAL_DISPLAY_FLAG_TRUSTED | ownFocus | noSteal;
+            Ln.i("Wellphone focus experiment: request flags=0x" + Integer.toHexString(flags));
